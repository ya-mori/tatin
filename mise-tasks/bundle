#!/usr/bin/env bash
#MISE description="指定アプリを .app にまとめて署名する（例: mise run bundle MenuBar）"
set -euo pipefail

cd "${MISE_PROJECT_ROOT:-$(git rev-parse --show-toplevel)}"

app="${1:-}"
if [ -z "$app" ]; then
    echo "アプリ名を指定してください（例: mise run bundle MenuBar）" >&2
    exit 2
fi
if [ ! -d "Apps/$app" ]; then
    echo "Apps/$app がありません。利用できるアプリ: $(ls Apps 2>/dev/null | tr '\n' ' ')" >&2
    exit 2
fi

plist="Apps/$app/Bundle/Info.plist"
if [ ! -f "$plist" ]; then
    echo "$plist がありません" >&2
    exit 2
fi

config="${TATIN_BUILD_CONFIG:-release}"
dist="${TATIN_DIST_DIR:-dist}"

swift build -c "$config" --product "$app"
bin="$(swift build -c "$config" --show-bin-path)/$app"

bundle="$dist/$app.app"
rm -rf "$bundle"
mkdir -p "$bundle/Contents/MacOS" "$bundle/Contents/Resources"
cp "$bin" "$bundle/Contents/MacOS/$app"
cp "$plist" "$bundle/Contents/Info.plist"
printf 'APPL????' > "$bundle/Contents/PkgInfo"

# アイコンがあれば入れる。Info.plist の CFBundleIconFile と名前を揃える必要があるため、
# 置き場所とファイル名は Bundle/AppIcon.icns に固定する。
icon="Apps/$app/Bundle/AppIcon.icns"
if [ -f "$icon" ]; then
    cp "$icon" "$bundle/Contents/Resources/AppIcon.icns"
fi

# 署名 ID は、TATIN_CODESIGN_IDENTITY → 開発用証明書 → ad-hoc の順に選ぶ。
#
# ad-hoc 署名は署名要件がビルド内容のハッシュそのものになるため、作り直すたびに
# macOS からは別のアプリに見える。キーチェーンの「常に許可」は署名要件ごとに
# 記録される仕組みなので、ad-hoc のままだとビルドのたびに許可を聞かれる。
# `mise run dev-cert` で作る証明書で署名すると、署名要件が証明書に紐づいて安定する。
dev_cert="${TATIN_DEV_CERT_NAME:-tatin development}"
identity="${TATIN_CODESIGN_IDENTITY:-}"
if [ -z "$identity" ]; then
    if security find-identity -v -p codesigning | grep -qF "$dev_cert"; then
        identity="$dev_cert"
    else
        identity="-"
    fi
fi
codesign --force --sign "$identity" --timestamp=none "$bundle"

echo "bundled: $bundle"
if [ "$identity" = "-" ]; then
    echo "  署名: ad-hoc. mise run dev-cert を流すとキーチェーンの許可が毎回出なくなる"
else
    echo "  署名: ${identity}"
fi
